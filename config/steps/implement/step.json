{
  "kind": "claude",
  "tools": ["Read", "Edit", "Write", "Glob", "Grep", "Bash", "Skill"],
  "allowedTools": ["Edit", "Write", "Bash(node *)", "Bash(npm run *)", "Bash(npx *)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)"],
  "disallowedTools": [
    "Agent",
    "Bash(git worktree*)",
    "Bash(git commit*)",
    "Bash(git push*)",
    "Bash(git checkout*)",
    "Bash(git switch*)",
    "Bash(git reset*)",
    "Bash(git stash*)",
    "Bash(rm -rf*)"
  ],
  "mcpServers": ["@auto"],
  "memory": "readwrite",
  "timeoutMs": 1800000
}
