{
  "name": "nexura",
  "version": "0.1.0",
  "private": true,
  "description": "Nexura by abastidadev — local IDE to orchestrate Claude Code flows",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm install && npm run build:web",
    "start": "npm run build:web && node apps/server/src/cli/cli.ts serve",
    "spike": "node --experimental-strip-types scripts/spike.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "nexura": "node apps/server/src/cli/cli.ts",
    "serve": "node apps/server/src/cli/cli.ts serve",
    "build:web": "npm run build -w @nexura/web",
    "dev:web": "npm start -w @nexura/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "nexura": "apps/server/src/cli/cli.ts"
  }
}
